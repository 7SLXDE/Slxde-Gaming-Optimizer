<Window x:Class="SlxdeOptimizer.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMD Settings Guide"
        Height="720"
        Width="920"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Border Background="#080D15"
            BorderBrush="#24364C"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#0B121D"
                    BorderBrush="#1E2D40"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="7"
                            Background="#14243A" BorderBrush="#2C8FFF" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                               Width="17" Height="23" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="SLXDE OPTI · AMD SETTINGS GUIDE"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="#DCE9F7" FontSize="13" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" Content="×" Click="Close_Click"
                            Width="34" Height="34" Background="Transparent" BorderThickness="0"
                            Foreground="#9DB6D1" FontSize="22" Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="10" BorderBrush="#203147" BorderThickness="1"
                        Background="#0D1522" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="40" CornerRadius="8"
                                Background="#14243A" BorderBrush="#2C8FFF" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="AMD" Foreground="#DCE9F7" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="AMD Settings Guide" Foreground="#DCE9F7"
                                       FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Follow these screenshots inside AMD Adrenalin."
                                       Foreground="#91ABC7" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,14" CornerRadius="10"
                        BorderBrush="#203147" BorderThickness="1" Background="#0D1522" Padding="12">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Image x:Name="GuideImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&lt;  PREVIOUS" Click="Previous_Click"
                            Padding="18,10" Background="#111C2B" Foreground="#DCE9F7"
                            BorderBrush="#203147" BorderThickness="1" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StepText" Foreground="#DCE9F7" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CaptionText" Foreground="#91ABC7" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="NEXT  &gt;" Click="Next_Click"
                            Padding="18,10" Background="#2589ED" Foreground="White"
                            BorderBrush="#35A1FF" BorderThickness="1" FontWeight="SemiBold"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
