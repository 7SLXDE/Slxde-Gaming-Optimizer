<Window x:Class="SlxdeOptimizer.App.SlxdeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLXDE OPTI"
        Width="460"
        MinWidth="420"
        MaxWidth="680"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Background="#080D15"
            BorderBrush="#24364C"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#0B121D"
                    BorderBrush="#1E2D40"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30"
                            CornerRadius="7"
                            Background="#14243A"
                            BorderBrush="#2C8FFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                               Width="17" Height="23" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="WindowTitleText"
                               Grid.Column="1"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#DCE9F7"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2"
                            Content="×"
                            Click="Close_Click"
                            Width="34" Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#9DB6D1"
                            FontSize="22"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconShell"
                            Width="40" Height="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="10"
                            Background="#14243A"
                            BorderBrush="#2C8FFF"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="IconText"
                                       Text="i"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="SemiBold"/>
                            <Path x:Name="SuccessTick"
                                  Visibility="Collapsed"
                                  Data="M 4,11 L 9,16 L 19,5"
                                  Stroke="#E7F2FF"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="22" Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  MaxHeight="470"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText"
                                   Foreground="#C8DAEC"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>

                <StackPanel x:Name="ButtonsHost"
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"/>
            </Grid>
        </Grid>
    </Border>
</Window>
