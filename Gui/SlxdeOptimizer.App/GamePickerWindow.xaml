<Window x:Class="SlxdeOptimizer.App.GamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Game"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#DCE9F7">
    <Border Background="#080D15"
            BorderBrush="#24364C"
            BorderThickness="1"
            CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#0B121D"
                BorderBrush="#1E2D40"
                BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="7"
                        Background="#14243A" BorderBrush="#2C8FFF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                           Width="17" Height="23" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Grid.Column="1" Text="SLXDE OPTI · CHOOSE GAME"
                           Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="#DCE9F7" FontSize="13" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="×" Click="Cancel_Click"
                        Width="34" Height="34" Background="Transparent" BorderThickness="0"
                        Foreground="#9DB6D1" FontSize="22" Cursor="Hand"/>
            </Grid>
        </Border>
    <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a game"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#DCE9F7"/>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,16"
                   Text="Shows genuine game executables from running games and installed Steam, Epic, Activision, Blizzard, EA, Ubisoft and Riot titles. Launchers, helpers and background services are filtered out."
                   TextWrapping="Wrap"
                   Foreground="#9DB6D1"
                   FontSize="13"/>

        <Border Grid.Row="2"
                Background="#0D1522"
                BorderBrush="#203147"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Text="Searching installed games..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#9DB6D1"
                           FontSize="14"/>
                <ListBox x:Name="GamesList"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#DCE9F7"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="GamesList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="#111C2B"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#203147"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#173454"/>
                                    <Setter Property="BorderBrush" Value="#2C8FFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,11"
                                    Background="Transparent"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#DCE9F7"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#8FAAC7"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="BROWSE MANUALLY"
                    Click="Browse_Click"
                    Padding="18,10"
                    Background="#14243A"
                    Foreground="#DCE9F7"
                    BorderBrush="#2C8FFF"
                    BorderThickness="1"/>
            <Button Grid.Column="1"
                    Content="RESTORE WINDOWS DEFAULT"
                    Click="RestoreDefault_Click"
                    Margin="10,0,0,0"
                    Padding="18,10"
                    Background="#111C2B"
                    Foreground="#DCE9F7"
                    BorderBrush="#203147"
                    BorderThickness="1"/>
            <Button Grid.Column="3"
                    Content="CANCEL"
                    Click="Cancel_Click"
                    Margin="0,0,10,0"
                    Padding="18,10"
                    Background="#111C2B"
                    Foreground="#DCE9F7"
                    BorderBrush="#203147"
                    BorderThickness="1"/>
            <Button Grid.Column="4"
                    Content="USE SELECTED  &gt;"
                    Click="UseSelected_Click"
                    Padding="22,10"
                    Background="#2589ED"
                    Foreground="White"
                    BorderBrush="#35A1FF"
                    BorderThickness="1"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
      </Grid>
    </Border>
</Window>
