<Window x:Class="SlxdeOptimizer.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMD Settings Guide"
        Height="820"
        Width="1000"
        MinHeight="650"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#05020D"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" BorderBrush="#FF3030" BorderThickness="1" Background="#120407" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="AMD"
                           Foreground="#FF3030"
                           FontSize="30"
                           FontWeight="Black"
                           FontFamily="Arial Black, Segoe UI Black, Segoe UI"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AMD SETTINGS GUIDE"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Black"/>
                    <TextBlock Text="Follow these screenshots inside AMD Adrenalin."
                               Foreground="#D8CCF8"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,14" CornerRadius="16" BorderBrush="#7D26FF" BorderThickness="1" Background="#090414" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="GuideImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="PREVIOUS" Click="Previous_Click" FontWeight="Bold"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="StepText" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CaptionText" Foreground="#D8CCF8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="NEXT" Click="Next_Click" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
