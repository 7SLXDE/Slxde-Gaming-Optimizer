<Window x:Class="SlxdeOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLXDE OPTI"
        Icon="Assets/Brand/slxde_app_icon_v1.ico"
        Height="860"
        Width="1360"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#080B11"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="TitleGlow" Color="#238BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.24"/>
        <DropShadowEffect x:Key="PurpleGlow" Color="#238BFF" BlurRadius="10" ShadowDepth="0" Opacity="0.18"/>
        <DropShadowEffect x:Key="SoftGlow" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.26"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0E15" Offset="0"/>
                <GradientStop Color="#080B11" Offset="0.55"/>
                <GradientStop Color="#07101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="#15263B"
                            BorderBrush="#238BFF"
                            BorderThickness="1">
                        <Image Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                               Width="24"
                               Height="32"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="SLXDE OPTI"
                                   Foreground="#FFFFFF"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="VERSION 0.15.4.0"
                                   Foreground="#70849B"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2"
                        Height="44"
                        CornerRadius="11"
                        BorderBrush="#1E2B3B"
                        BorderThickness="1"
                        Background="#0D111A"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Padding="14,0"
                        Width="260">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="STATUS"
                                   Foreground="#FFFFFF"
                                   FontWeight="Black"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="2"
                                   Text="Ready"
                                   Foreground="#AEBBC9"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="#1E2B3B"
                    BorderThickness="1"
                    Background="#0D111A"
                    CornerRadius="12"
                    Padding="10"
                    Effect="{StaticResource SoftGlow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="0"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,4">
                            <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButton}" Click="Dashboard_Click"/>
                            <Button x:Name="BtnWindows" Style="{StaticResource SidebarButton}" Click="Windows_Click"/>
                            <Button x:Name="BtnGpu" Style="{StaticResource SidebarButton}" Click="Gpu_Click"/>
                            <Button x:Name="BtnNetwork" Style="{StaticResource SidebarButton}" Click="Network_Click"/>
                            <Button x:Name="BtnController" Style="{StaticResource SidebarButton}" Click="Controller_Click"/>
                            <Button x:Name="BtnGameConfigs" Style="{StaticResource SidebarButton}" Click="GameConfigs_Click"/>
                            <Button x:Name="BtnDebloat" Style="{StaticResource SidebarButton}" Click="Debloat_Click"/>
                            <Button x:Name="BtnCleanup" Style="{StaticResource SidebarButton}" Click="Cleanup_Click"/>
                            <Button x:Name="BtnQuality" Style="{StaticResource SidebarButton}" Click="Quality_Click"/>
                            <Button x:Name="BtnBackup" Style="{StaticResource SidebarButton}" Click="Backup_Click"/>
                            </StackPanel>
                        </ScrollViewer>
</Grid>
                </Grid>
            </Border>

            <!-- Main Panel -->
            <Border Grid.Row="1" Grid.Column="2"
                    CornerRadius="12"
                    BorderBrush="#1E2B3B"
                    BorderThickness="1"
                    Background="#0D121B"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.RowSpan="2"
                           Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                           Width="260"
                           Opacity="0.025"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,26,22"/>

                    <Border Grid.RowSpan="2"
                            Height="2"
                            Margin="0,-8,0,0"
                            CornerRadius="1"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#238BFF" Offset="0"/>
                                <GradientStop Color="#238BFF" Offset="0.35"/>
                                <GradientStop Color="#00238BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64"
                                CornerRadius="14"
                                BorderBrush="#28425F"
                                BorderThickness="1"
                                Background="#15263B"
                                Effect="{StaticResource PurpleGlow}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentControl x:Name="PageIconHost"
                                            Width="36"
                                            Height="36"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle"
                                       Text="WINDOWS SETTINGS"
                                       Foreground="#DCE9F7"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="26"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle"
                                       Text="Fine-tune and optimise Windows settings for performance and responsiveness."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CardsHost" Margin="0,8,0,14"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
