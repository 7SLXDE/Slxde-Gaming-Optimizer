<Window x:Class="SlxdeOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLXDE'S OPTI"
        Height="960"
        Width="1536"
        MinHeight="760"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="#020A13"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="TitleGlow" Color="#22B7FF" BlurRadius="22" ShadowDepth="0" Opacity="0.78"/>
        <DropShadowEffect x:Key="PurpleGlow" Color="#168EFF" BlurRadius="18" ShadowDepth="0" Opacity="0.48"/>
        <DropShadowEffect x:Key="SoftGlow" Color="#167BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.32"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.72,0.18" RadiusX="0.95" RadiusY="0.72">
                <GradientStop Color="#082A4A" Offset="0"/>
                <GradientStop Color="#030E1D" Offset="0.48"/>
                <GradientStop Color="#02050A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.34">
            <Ellipse Width="780" Height="260" Canvas.Left="570" Canvas.Top="80"
                     Stroke="#2FA8FF" StrokeThickness="2" Opacity="0.10"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-14"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="430" Height="110" Canvas.Left="85" Canvas.Top="650"
                     Stroke="#22B7FF" StrokeThickness="2" Opacity="0.10"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-16"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Path Data="M780,145 C940,65 1045,100 1210,22" Stroke="#168EFF" StrokeThickness="2" Opacity="0.10"/>
            <Path Data="M850,235 C980,155 1120,205 1280,115" Stroke="#22B7FF" StrokeThickness="1" Opacity="0.09"/>
        </Canvas>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="128"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="345"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="164"
                        Height="62"
                        CornerRadius="14"
                        BorderBrush="#163A61"
                        BorderThickness="1"
                        Background="#061222"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="11"
                                 Height="11"
                                 Fill="#2EA8FF"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#22B7FF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Text="v 0.9.65"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="760"
                        Height="104"
                        CornerRadius="18"
                        Background="#03101E"
                        BorderBrush="#155B9F"
                        BorderThickness="1"
                        ClipToBounds="True"
                        Effect="{StaticResource TitleGlow}">
                    <Grid>
                            <TextBlock Text="SLXDE'S OPTI"
                                       Foreground="White"
                                       FontSize="38"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Black, Segoe UI"
                                       Opacity="0.96"/>
                            <Grid>
                            <!-- SLXDE_BANNER_FALLBACK_v0951 -->
                            <TextBlock Text="SLXDE'S OPTI"
                                       Foreground="White"
                                       FontSize="38"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Black, Segoe UI"
                                       Opacity="0.96"/>
                            <Image Source="pack://application:,,,/Assets/Brand/slxde_opti_banner_blue.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        </Grid>
                </Border>
                <Border Grid.Column="2"
                        Height="62"
                        CornerRadius="14"
                        BorderBrush="#163A61"
                        BorderThickness="1"
                        Background="#061222"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Padding="20,0"
                        Width="342">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="13"
                                 Height="13"
                                 Fill="{StaticResource GreenBrush}"
                                 Margin="0,0,15,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#21E6FF" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Text="STATUS"
                                   Foreground="#FFFFFF"
                                   FontWeight="Black"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,18,0"/>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="2"
                                   Text="Ready"
                                   Foreground="#DCD5EA"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="#154B78"
                    BorderThickness="1"
                    Background="#030C18"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource SoftGlow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="0"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,4">
                            <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButton}" Click="Dashboard_Click"/>
                            <Button x:Name="BtnWindows" Style="{StaticResource SidebarButton}" Click="Windows_Click"/>
                            <Button x:Name="BtnGpu" Style="{StaticResource SidebarButton}" Click="Gpu_Click"/>
                            <Button x:Name="BtnNetwork" Style="{StaticResource SidebarButton}" Click="Network_Click"/>
                            <Button x:Name="BtnController" Style="{StaticResource SidebarButton}" Click="Controller_Click"/>
                            <Button x:Name="BtnGameConfigs" Style="{StaticResource SidebarButton}" Click="GameConfigs_Click"/>
                            <Button x:Name="BtnDebloat" Style="{StaticResource SidebarButton}" Click="Debloat_Click"/>
                            <Button x:Name="BtnCleanup" Style="{StaticResource SidebarButton}" Click="Cleanup_Click"/>
                            <Button x:Name="BtnQuality" Style="{StaticResource SidebarButton}" Click="Quality_Click"/>
                            <Button x:Name="BtnBackup" Style="{StaticResource SidebarButton}" Click="Backup_Click"/>
                            </StackPanel>
                        </ScrollViewer>
</Grid>
                </Grid>
            </Border>

            <!-- Main Panel -->
            <Border Grid.Row="1" Grid.Column="2"
                    CornerRadius="16"
                    BorderBrush="#154B78"
                    BorderThickness="1"
                    Background="#030B16"
                    Padding="34">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="122"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="92" Height="92"
                                CornerRadius="18"
                                BorderBrush="#2FA8FF"
                                BorderThickness="2"
                                Background="#052B5C"
                                Effect="{StaticResource PurpleGlow}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="PageIconImage"
                                       Width="58"
                                       Height="58"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="PageIcon"
                                           Text=""
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#FFFFFF"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle"
                                       Text="WINDOWS SETTINGS"
                                       Foreground="#FFFFFF"
                                       FontSize="42"
                                       FontWeight="Black"/>
                            <TextBlock x:Name="PageSubtitle"
                                       Text="Fine-tune and optimise Windows settings for performance and responsiveness."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="17"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CardsHost" Margin="0,12,0,18"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
