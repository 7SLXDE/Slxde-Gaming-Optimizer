<Window x:Class="SlxdeOptimizer.App.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Analysis"
        Width="820"
        Height="680"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#080D15"
            BorderBrush="#24364C"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B121D"
                    BorderBrush="#1E2D40"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30"
                            CornerRadius="7"
                            Background="#14243A"
                            BorderBrush="#2C8FFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/Brand/slxde_s_mark_header_v1.png"
                               Width="17" Height="23" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="SLXDE OPTI · PC ANALYSIS"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#DCE9F7"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="2"
                            Content="×"
                            Click="Close_Click"
                            Width="34" Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#9DB6D1"
                            FontSize="22"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,22,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gaming readiness"
                                   Foreground="#DCE9F7"
                                   FontSize="27"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="A clear overview of your hardware and important Windows gaming settings."
                                   Margin="0,6,0,0"
                                   Foreground="#91ABC7"
                                   FontSize="13"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="92" Height="72"
                            Margin="20,0,0,0"
                            CornerRadius="12"
                            Background="#112238"
                            BorderBrush="#2C8FFF"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreText"
                                       Text="-- / 100"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="SCORE"
                                       Margin="0,3,0,0"
                                       Foreground="#86BDF2"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,22,0,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SYSTEM INFORMATION"
                                   Foreground="#87A7C8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,8"/>
                        <UniformGrid x:Name="SystemGrid" Columns="2"/>

                        <TextBlock Text="GAMING SETTINGS"
                                   Foreground="#87A7C8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,18,0,8"/>
                        <UniformGrid x:Name="SettingsGrid" Columns="2"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="SummaryText"
                               VerticalAlignment="Center"
                               Foreground="#91ABC7"
                               FontSize="12"/>
                    <Button HorizontalAlignment="Right"
                            Content="DONE  &gt;"
                            Click="Close_Click"
                            MinWidth="140"
                            Padding="22,11"
                            Background="#2589ED"
                            Foreground="White"
                            BorderBrush="#35A1FF"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
